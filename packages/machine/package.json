{
  "name": "@sthir/machine",
  "version": "0.5.1",
  "description": "A state machine",
  "main": "dist/sthir-machine.cjs.js",
  "module": "dist/sthir-machine.esm.js",
  "sideEffects": false,
  "preconstruct": {
    "entrypoints": [
      "index.ts",
      "effect/index.ts"
    ]
  },
  "files": [
    "dist",
    "effect/dist",
    "effect/package.json"
  ],
  "author": {
    "name": "Devansh Jethmalani",
    "email": "jethmalani.devansh@gmail.com"
  },
  "license": "MIT",
  "readme": "https://github.com/devanshj/sthir/tree/main/packages/machine/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devanshj/sthir.git"
  },
  "scripts": {
    "test": "yarn test:fork; yarn test:types",
    "test:types": "node test/run-type-suite.js stock",
    "test:fork": "node test/run-type-suite.js fork",
    "build": "cd ../../ && preconstruct build",
    "postbuild": "node fix-is-fork-dts"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "effect": "^4.0.0-rc.112"
  }
}
